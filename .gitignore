# The shared FRED observation cache (re-derivable; keyed by series, cadence-aware TTL)
# fred-cache.json is NOT ignored in this fork: it is committed as the seed
# list of series the app uses, so a clean Netlify build knows what to fetch.
# Owner wealth: 24h feed cache and the permanent SOI tax-year extracts (re-derivable)
owner-wealth.json
soi-archive.json
# Capex returns: 24h feed cache (re-derivable from SEC XBRL)
capex-returns.json
household-wealth.json
scf-archive.json

# Baked API responses are a build artifact — scripts/bake.mjs regenerates them
# on every build, including on Netlify. fred-cache.json above is the seed and
# IS committed; these are its output.
public/api/

# Silicon Data index marks: typed in by hand from their public index page. Their
# licence covers internal use only, and this repo is public, so the file stays
# on this machine. server/tokenSpot.js treats it as optional.
data/ai/silicon-data-marks.json
# Tightening monitor: 6h feed cache (re-derivable from FRED + Treasury FiscalData)
tightening.json
# Trade flows: 12h feed cache (re-derivable; data/fx/invoicing.json is the tracked reference table)
trade-flows.json
